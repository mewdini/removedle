# R2 credentials for scripts/lib/r2.js (the `scan`, `generate`, and sync-r2 pipeline).
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#
# Create these under: Cloudflare dashboard -> R2 -> API -> Manage API Tokens.
# The token needs "Object Read & Write" on the three buckets below.
#
# The same three values must exist as GitHub Actions secrets for
# .github/workflows/daily-challenges.yml and sync-metadata.yml to run:
#   gh secret set R2_ACCOUNT_ID
#   gh secret set R2_ACCESS_KEY_ID
#   gh secret set R2_SECRET_ACCESS_KEY

# Cloudflare account ID. Also the S3 endpoint host:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# R2 API token credentials (S3-compatible access key pair)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Buckets are NOT configured here. They are defined in scripts/lib/r2.js:
#   removedle-music-list  <- tagged source audio        (out/masters)
#   removedle-data        <- song-registry.json, manifests, art/  (out/data, out/covers)
#   removedle-challenges  <- daily snippets + meta.json (out/dailies)

# Optional: edge cache purge for `pnpm purge`. Only needed when you change content
# that is already live and cached (reissuing a released day's audio, or a static
# asset). A normal deploy never needs it. The token needs Zone > Cache Purge.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=

# Streaming-link resolution for `pnpm links`. Key from https://ml.jadquir.com
# (Songlink/Odesli successor). Server-side only. Free tier ~300 req/month.
MUSICLINK_API_KEY=
