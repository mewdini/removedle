{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "removedle",
    "compatibility_date": "2026-05-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "main": ".svelte-kit/cloudflare/_worker.js",
    "assets": {
        "directory": ".svelte-kit/cloudflare",
        "binding": "ASSETS"
    },
    "preview_urls": true,
    "observability": {
        "enabled": true
    },
    // Production. `d1_databases` is NOT inherited by `env.*` blocks, so every
    // environment must redeclare its own, or it silently gets no DB binding.
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "removedle",
            "database_id": "7dcd629e-a158-4fd4-a30a-af019596eab2",
            "migrations_dir": "./drizzle"
        }
    ],
    // Private bucket: deliberately has NO public access and NO custom domain.
    // It holds future days, which are only reachable through the date gate in
    // src/routes/challenges/[date=date]/[file]/+server.ts.
    "r2_buckets": [
        {
            "binding": "CHALLENGES",
            "bucket_name": "removedle-challenges"
        }
    ],
    "env": {
        // Deploys as a separate Worker `removedle-preview` bound to its own
        // database, so preview traffic never writes to production stats.
        "preview": {
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "removedle-preview",
                    "database_id": "84ddd900-260a-471c-b407-373192d66c91",
                    "migrations_dir": "./drizzle"
                }
            ],
            // Same bucket as production: challenge media is read-only to the app,
            // and preview should show the real challenges. Redeclared because
            // `r2_buckets`, like `d1_databases`, is not inherited by env blocks.
            "r2_buckets": [
                {
                    "binding": "CHALLENGES",
                    "bucket_name": "removedle-challenges"
                }
            ]
        }
    }
}
