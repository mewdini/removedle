{
    "name": "removedle",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "description": "Daily guessing challenge game for Jane Remover's music!",
    "scripts": {
        "dev": "vite dev",
        "dev:host": "vite dev --host",
        "build": "vite build",
        "preview": "pnpm build && wrangler dev",
        "deploy:prod": "node scripts/check-deployable.js && pnpm build && wrangler deploy",
        "purge": "node scripts/purge-cache.js",
        "links": "node scripts/resolve-links.js",
        "links:issues": "node scripts/link-issues.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate:local": "wrangler d1 migrations apply DB --local",
        "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
        "lint": "prettier --check --write . && eslint . --fix",
        "scan": "node scripts/scan-songs.js",
        "generate": "node scripts/generate-daily.js",
        "convert": "node scripts/convert-masters.js",
        "bootstrap": "node scripts/bootstrap-registry.js",
        "scan:challenger": "node scripts/scan-songs.js --mode=challenger",
        "generate:challenger": "node scripts/generate-daily.js --mode=challenger",
        "convert:challenger": "node scripts/convert-masters.js --mode=challenger",
        "bootstrap:challenger": "node scripts/bootstrap-registry.js --mode=challenger",
        "links:challenger": "node scripts/resolve-links.js --mode=challenger",
        "links:review": "node scripts/link-review.js"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "@iconify-json/streamline-logos": "^1.2.0",
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/adapter-cloudflare": "^7.2.9",
        "@sveltejs/kit": "^2.70.1",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^22.20.1",
        "drizzle-kit": "0.31.10",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.22.0",
        "flowbite-svelte-icons": "^3.1.0",
        "globals": "^17.7.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^3.5.2",
        "prettier-plugin-tailwindcss": "^0.7.4",
        "svelte": "^5.56.7",
        "svelte-check": "^4.7.3",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^7.3.6",
        "wrangler": "^4.113.0"
    },
    "keywords": [],
    "author": "mewdini",
    "license": "ISC",
    "packageManager": "pnpm@11.16.0",
    "allowBuilds": {
        "esbuild": true,
        "sharp": true,
        "workerd": true
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1093.0",
        "@fontsource/poppins": "^5.3.0",
        "@msgpack/msgpack": "^3.1.3",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "fast-fuzzy": "^1.12.0",
        "ffmpeg-static": "^5.3.0",
        "mime": "^4.1.0",
        "music-metadata": "^11.14.0"
    }
}
